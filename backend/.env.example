# Copy this file to .env and fill in your real values. Never commit .env itself.

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:yazhini%40185@localhost:5432/portfolio_db

# Simple shared-secret key to protect the admin endpoints (Phase 4).
# Send it as a header: X-Admin-Key: <this value>
ADMIN_API_KEY=change-this-to-a-long-random-string

# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CORS_ORIGINS=http://localhost:5173

# Email notification when someone submits the Contact form (optional).
# Uses Gmail SMTP by default. You need a Gmail "App Password", not your
# normal password — see README.md "Email notifications" section for steps.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yds.digitalservice185@gmail.com
SMTP_PASSWORD=your-16-character-app-password
NOTIFY_EMAIL=yds.digitalservice185@gmail.com

# SMS notification when someone submits the Contact form (optional).
# Uses Twilio (https://www.twilio.com) — sign up, buy/verify a sending
# number, and copy your Account SID + Auth Token from the Twilio console.
# See README.md "SMS notifications" section for step-by-step setup.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
NOTIFY_PHONE=+91xxxxxxxxxx

# WhatsApp notification when someone submits the Contact form (optional).
# Same Twilio account as above, different "channel" — see README.md
# "WhatsApp notifications" section for step-by-step setup.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
NOTIFY_WHATSAPP=whatsapp:+91xxxxxxxxxx
